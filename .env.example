# Copy to .env and fill in. Never commit .env itself.
# The VITE_ prefix is required -- Vite ignores unprefixed variables silently.

# Project URL, no trailing slash. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The "anon" public key from Project Settings > API.
# Safe to ship in the browser; RLS is what protects your data.
# Never use the service_role key here -- it bypasses RLS entirely.
VITE_SUPABASE_ANON_KEY=
